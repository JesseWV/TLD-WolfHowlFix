<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>WolfHowlFix</RootNamespace>
    <AssemblyName>WolfHowlFix</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <FileVersion>2.0.1.0</FileVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <DebugType>none</DebugType>
    <!-- Il2Cpp interop proxies trip a lot of these; they are not actionable here. -->
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <!-- _dev holds REPL snippets and tooling, not project source. They are standalone scripts
       with top-level statements, so the default **/*.cs glob would try to compile them. -->
  <ItemGroup>
    <Compile Remove="_dev/**" />
    <None Remove="_dev/**" />
  </ItemGroup>

  <!-- Il2Cpp reference assemblies + ModSettings via NuGet, so the project builds without a
       local game install. ModSettings pulls in STBlade's 2.10.0 assemblies transitively; the
       explicit reference below outranks it and provides the 2.55-era types we need. -->
  <ItemGroup>
    <PackageReference Include="Waltz.Modding.TLD.Il2CppAssemblies.Windows" Version="2.52.0" />
    <PackageReference Include="STBlade.Modding.TLD.ModSettings" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="ModSettings" />
  </ItemGroup>

</Project>
